{
  "name": "inter-shop-sequelize-server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "prestart": "node src/scripts/setup.js",
    "start": "node src/index.js",
    "predev": "node src/scripts/setup.js",
    "dev": "nodemon src/index.js",
    "db:setup": "node src/scripts/setup.js",
    "db:create": "sequelize db:create",
    "db:drop": "sequelize db:drop",
    "migrate": "sequelize db:migrate",
    "migrate:undo": "sequelize db:migrate:undo:all",
    "seed": "sequelize db:seed:all",
    "seed:undo": "sequelize db:seed:undo:all",
    "db:reset": "sequelize db:migrate:undo:all && sequelize db:migrate && sequelize db:seed:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "engines": {
    "node": ">=18"
  }
}
