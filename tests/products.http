@baseUrl = http://localhost:3000/api/products

###
GET {{baseUrl}}

###
GET {{baseUrl}}?limit=50

###
GET {{baseUrl}}/id-greater

###
GET {{baseUrl}}/id-greater?value=40

###
GET {{baseUrl}}/by-brands?brandIds=1,3,4

###
GET {{baseUrl}}/1

###
# @name createProduct
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "Galaxy Z Fold 6",
  "model": "SM-F956",
  "price": 1899.99,
  "quantity": 5,
  "brandId": 1,
  "categoryId": 1
}

###
# @name createProduct2
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "Galaxy Z Flip 6",
  "model": "SM-F741",
  "price": 1099.99,
  "quantity": 8,
  "brandId": 1,
  "categoryId": 1
}

###
PATCH {{baseUrl}}/{{createProduct.response.body.data.id}}
Content-Type: application/json

{
  "price": 1799.99,
  "quantity": 10
}

###
PATCH {{baseUrl}}/price
Content-Type: application/json

{
  "brandIds": [10, 11],
  "percent": -10
}

###
PATCH {{baseUrl}}/price
Content-Type: application/json

{
  "brandIds": [10, 11],
  "percent": 11.11
}

###
DELETE {{baseUrl}}
Content-Type: application/json

{
  "ids": [{{createProduct.response.body.data.id}}, {{createProduct2.response.body.data.id}}]
}

###
POST {{baseUrl}}
Content-Type: application/json

{
  "title": "Bad product",
  "price": -5,
  "categoryId": 1
}

###
POST {{baseUrl}}
